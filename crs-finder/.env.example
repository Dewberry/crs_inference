# CRS Finder — backend environment variables
# Set these in docker-compose, systemd, or your deployment environment.
# The backend does NOT auto-load a .env file at runtime.

# Comma-separated list of allowed CORS origins.
# In production set this to your frontend URL (e.g. https://crs-finder.example.com).
# Default: http://localhost:5173 (Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173

# Maximum size of uploaded geometry or target files, in bytes.
# Default: 524288000 (500 MB)
MAX_UPLOAD_BYTES=524288000
